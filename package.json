{
  "name": "holaliz",
  "version": "1.0.2",
  "description": "Liz UX Design Portfolio",
  "main": "index.js",
  "scripts": {
    "sass:watch": "sass --watch --poll scss:assets/css",
    "compile:sass": "sass --watch scss:assets/css",
    "dev": "concurrently \"npm run sass:watch\" \"browser-sync start --server --files '**/*.html, assets/css/*.css, **/*.js'\"",
    "generate:posters": "bash scripts/generate-posters.sh",
    "generate:webp": "bash scripts/generate-webp.sh",
    "cache:bump": "python3 scripts/bump-cache.py"
  },
  "keywords": [
    "UX",
    "Design",
    "Research",
    "Portfolio",
    "Designer"
  ],
  "author": "Lizbeth Martinez",
  "license": "ISC",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "sass": "^1.62.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.1",
    "bootstrap": "^5.3.8"
  }
}

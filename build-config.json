{
  "version": "1.0.0",
  "build": {
    "timestamp": "auto",
    "environment": "production",
    "minify": true,
    "sourcemaps": false
  },
  "assets": {
    "css": {
      "main": "assets/css/style.css",
      "fontawesome": "assets/css/fontawesome.css",
      "output": "assets/css/style.min.css",
      "versioning": true
    },
    "js": {
      "main": "assets/js/script.js",
      "contact": "assets/js/contact-form.js",
      "analytics": "assets/js/analytics.js",
      "performance": "assets/js/performance.js",
      "versioning": "assets/js/version-manager.js",
      "output": "assets/js/bundle.min.js",
      "versioning": true
    },
    "images": {
      "critical": [
        "images/face-img.png",
        "images/logo.png",
        "images/projects/BDDrivers/thumb-deep.png",
        "images/projects/Rewards/thumb-deep.png",
        "images/projects/Travelers-research/thumb-deep.png",
        "images/projects/Storybook/thumb-deep.png"
      ],
      "versioning": true
    }
  },
  "cache": {
    "css": {
      "maxAge": 31536000,
      "immutable": true
    },
    "js": {
      "maxAge": 31536000,
      "immutable": true
    },
    "images": {
      "maxAge": 31536000,
      "immutable": true
    },
    "html": {
      "maxAge": 3600,
      "immutable": false
    }
  },
  "cdn": {
    "enabled": false,
    "url": "",
    "fallback": true
  },
  "monitoring": {
    "performance": true,
    "errors": true,
    "analytics": true
  }
}
